/* ── Blade Runner Rofi ── */

* {
    font: "JetBrainsMono Nerd Font Bold 12";
    bg:     #0d1117ff;
    fg:     #d4c5a0ff;
    muted:  #4a4f5aff;
    accent: #ff8c42ff;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: ">";
}

window {
    transparency: "real";
    width: 520px;
    border-radius: 0px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    padding: 0;
}

mainbox {
    spacing: 0;
    margin: 0;
    padding: 0;
    children: ["inputbar", "listview"];
}

inputbar {
    children: ["prompt", "entry"];
    spacing: 8px;
    background-color: @bg;
    border: 0 0 2px 0 solid;
    border-color: @accent;
    padding: 10px 12px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
    padding: 0;
}

entry {
    placeholder: "Search applications...";
    text-color: @fg;
    placeholder-color: @muted;
    padding: 0;
    background-color: transparent;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0;
    spacing: 0;
    padding: 4px 0;
    background-color: @bg;
}

element {
    spacing: 10px;
    margin: 0;
    padding: 8px 12px;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 22px;
    margin: 0 8px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color: @bg;
    border: 0;
    border-radius: 0;
}

message {
    background-color: transparent;
    border: 0;
}
