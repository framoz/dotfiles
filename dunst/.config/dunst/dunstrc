# ── Tokyonight Dunst ──

[global]
    # ── Display ──
    monitor = 0
    follow = mouse

    # ── Geometry ──
    width = 350
    height = 120
    origin = top-right
    offset = 12x12
    notification_limit = 5

    # ── Appearance ──
    frame_width = 2
    frame_color = "#7aa2f7"
    corner_radius = 12
    separator_height = 2
    separator_color = "#24283b"
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    gap_size = 6

    # ── Progress bar (volume/brightness OSD) ──
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4

    # ── Text ──
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end

    # ── Icons ──
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_theme = "Papirus-Dark"

    # ── Behavior ──
    sort = update
    idle_threshold = 120
    show_indicators = yes
    sticky_history = yes
    history_length = 20

    # ── Mouse ──
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#565f89"
    frame_color = "#24283b"
    highlight = "#7aa2f7"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    highlight = "#7aa2f7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0
