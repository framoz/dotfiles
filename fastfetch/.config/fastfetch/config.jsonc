{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;108;196;212",
            "title": "38;2;255;140;66",
            "output": "38;2;212;197;160",
            "separator": "38;2;74;79;90"
        }
    },
    "logo": {
        "type": "none"
    },
    "modules": [
        { "type": "custom", "format": "\u001b[38;2;255;140;66m         __  _         ___ \u001b[0m" },
        { "type": "custom", "format": "\u001b[38;2;108;196;212m  ____ \u001b[38;2;255;140;66m / /_(_)__ ____|_  |\u001b[0m" },
        { "type": "custom", "format": "\u001b[38;2;108;196;212m /___/ \u001b[38;2;255;140;66m/ __/ / -_) __/ __/ \u001b[0m" },
        { "type": "custom", "format": "\u001b[38;2;108;196;212m/___/  \u001b[38;2;255;140;66m\\__/_/\\__/_/ /____/ \u001b[0m" },
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────",
            "outputColor": "38;2;74;79;90"
        },
        { "type": "os",        "key": "[OS ]" },
        { "type": "kernel",    "key": "[KER]" },
        { "type": "wm",        "key": "[WM ]" },
        { "type": "terminal",  "key": "[TTY]" },
        { "type": "shell",     "key": "[SH ]" },
        { "type": "packages",  "key": "[PKG]" },
        "break",
        { "type": "cpu",       "key": "[CPU]" },
        { "type": "gpu",       "key": "[GPU]" },
        { "type": "memory",    "key": "[MEM]" },
        { "type": "disk",      "key": "[DSK]", "folders": "/" },
        { "type": "battery",   "key": "[BAT]" },
        { "type": "uptime",    "key": "[UP ]" }
    ]
}
